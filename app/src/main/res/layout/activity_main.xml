<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="18dp">

            <!-- Header Title and Action Icons -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:text="PC GAMERS" android:textColor="@color/accent2"
                        android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.12"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <TextView android:text="Market" android:textColor="@color/text"
                        android:textStyle="bold" android:textSize="28sp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView android:id="@+id/btnAddGame" android:text="+ Game" android:textColor="@color/text"
                    android:textSize="12sp" android:textStyle="bold" android:background="@drawable/bg_pill"
                    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp"/>

                <TextView android:id="@+id/btnCartHeader" android:text="🛒 0" android:textColor="@color/text"
                    android:textSize="13sp" android:textStyle="bold" android:background="@drawable/bg_search"
                    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp"/>

                <TextView android:id="@+id/btnFavHeader" android:text="♡" android:textColor="@color/text" android:textSize="26sp"
                    android:gravity="center" android:layout_width="40dp" android:layout_height="40dp"/>
            </LinearLayout>

            <TextView android:text="Temukan game PC yang ingin kamu mainkan."
                android:textColor="@color/muted" android:textSize="14sp"
                android:layout_marginTop="3dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <!-- Search Input -->
            <EditText android:id="@+id/searchInput" android:layout_width="match_parent"
                android:layout_height="52dp" android:layout_marginTop="16dp"
                android:hint="Cari game, genre, atau publisher..."
                android:textColor="@color/text" android:textColorHint="@color/muted"
                android:singleLine="true" android:background="@drawable/bg_search"
                android:paddingStart="16dp" android:paddingEnd="16dp"/>

            <!-- Category Chips -->
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:id="@+id/chipAll" android:text="Semua" android:textColor="@color/text" android:background="@drawable/bg_pill"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="9dp" android:paddingBottom="9dp"/>
                    <TextView android:id="@+id/chipOpenWorld" android:text="Open World" android:textColor="@color/muted"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="9dp" android:paddingBottom="9dp"/>
                    <TextView android:id="@+id/chipAction" android:text="Action" android:textColor="@color/muted"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="9dp" android:paddingBottom="9dp"/>
                    <TextView android:id="@+id/chipRacing" android:text="Racing" android:textColor="@color/muted"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="9dp" android:paddingBottom="9dp"/>
                    <TextView android:id="@+id/chipRpg" android:text="RPG" android:textColor="@color/muted"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="9dp" android:paddingBottom="9dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Section Title and Sort Option -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp">
                <TextView android:id="@+id/txtSectionTitle" android:text="Game populer" android:textColor="@color/text" android:textStyle="bold"
                    android:textSize="19sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/btnSort" android:text="🔃 Urutkan" android:textColor="@color/accent2" android:textSize="13sp"
                    android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/btnSeeAll" android:text="Lihat semua" android:textColor="@color/muted" android:textSize="13sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Custom ListView -->
            <ListView android:id="@+id/gameList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:divider="@android:color/transparent"
                android:dividerHeight="12dp" android:nestedScrollingEnabled="false"
                android:layout_marginTop="10dp"/>

            <!-- Empty State Text -->
            <TextView android:id="@+id/emptyText" android:text="Game tidak ditemukan"
                android:textColor="@color/muted" android:textSize="14sp" android:gravity="center"
                android:visibility="gone" android:padding="20dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>

            <TextView android:text="Tekan lama item game untuk menghapusnya. Harga dan informasi di aplikasi ini hanya untuk simulasi marketplace UTS."
                android:textColor="@color/muted" android:textSize="11sp" android:gravity="center"
                android:layout_marginTop="14dp" android:layout_marginBottom="10dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
