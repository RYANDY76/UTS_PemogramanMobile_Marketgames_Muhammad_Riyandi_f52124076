<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp" android:background="@color/surface">
    <ImageView android:id="@+id/detailCover" android:layout_width="match_parent" android:layout_height="190dp"
        android:scaleType="centerCrop"/>
    <TextView android:id="@+id/detailTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="14dp"/>
    <TextView android:id="@+id/detailMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/muted" android:textSize="13sp" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/detailDesc" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/text" android:textSize="14sp" android:lineSpacingExtra="4dp" android:layout_marginTop="12dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
        <TextView android:id="@+id/detailPrice" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/accent2" android:textSize="20sp" android:textStyle="bold"/>
        <TextView android:id="@+id/detailShareBtn" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔗 Bagikan" android:textColor="@color/accent2" android:textSize="14sp" android:padding="8dp" android:layout_marginEnd="6dp"/>
        <TextView android:id="@+id/detailFavBtn" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="♡ Favorit" android:textColor="@color/muted" android:textSize="14sp" android:padding="8dp"/>
    </LinearLayout>
    <Button android:id="@+id/detailBuyBtn" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="14dp" android:background="@drawable/bg_button"
        android:text="Beli Game Sekarang" android:textColor="@color/text" android:textStyle="bold" android:textSize="15sp"/>
</LinearLayout>
